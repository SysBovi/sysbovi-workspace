# Credenciais do PostgreSQL (usado pelo docker-compose)
# Copie este arquivo para .env e preencha com seus valores
POSTGRES_USER=sysbovi_user
POSTGRES_PASSWORD=troque_por_senha_forte
POSTGRES_DB=sysbovi_db

# ─── Cache (Redis) ────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque_por_senha_redis_forte

# ─── API (sysbovi-api) ───────────────────────────────────────────────────────
JWT_SECRET=troque_por_chave_jwt_de_pelo_menos_64_caracteres
JWT_EXPIRES_IN=8h
FRONTEND_URL=http://localhost:3000

# ─── Admin Web (sysbovi-admin-web) ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
